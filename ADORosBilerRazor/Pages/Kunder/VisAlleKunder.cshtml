@page
@model ADORosBilerRazor.Pages.Kunder.VisAlleKunderModel
@{
}
<h1 class="display-3 mb-5">Kunder</h1>

<div class="container">
    <div class="row">
        @foreach (var elem in Model.Kunder)
        {
            <div class="col-md-4 p-3">
                <div class="card shadow" style="width: 18rem;">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title">@elem.Navn</h3>
                        <h5>@(elem.Telefon)</h5>
                        <h5>@((elem.VIP ? "VIP" : "ikke VIP"))</h5>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

